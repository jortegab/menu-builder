DATABASE_URL=postgresql+psycopg://menu:menu@db:5432/menu

COMPANY_NAME=Alimentos y Servicios
TZ=America/Costa_Rica

# restaurant-manager's read-only JSON API (PLAN.md §5). From inside this
# container the upstream app is reachable on the host, not on this Compose
# network -- host.docker.internal is mapped in docker-compose.yml for that.
UPSTREAM_API_URL=http://host.docker.internal:8000/api/v3
# The key restaurant-manager's Ajustes → API y MCP shows once when it is
# created; sent as X-Api-Key. Blank, upstream answers 401 to every sync.
# Never commit a real key here.
UPSTREAM_API_KEY=
UPSTREAM_TIMEOUT_SECONDS=15

# Costing defaults (PLAN.md §7.4). Overridable per insumo from the UI.
#   last | avg_window | weighted_avg_window | median_window | max_window | min_window
COSTING_METHOD_DEFAULT=median_window
COSTING_WINDOW_DAYS_DEFAULT=90

# LLM-assisted insumo mapping (PLAN.md §8) -- optional. Leave blank and the
# mapping queue falls back to deterministic string similarity; it never
# blocks on this call succeeding. Never commit a real key here.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_TIMEOUT_SECONDS=20
